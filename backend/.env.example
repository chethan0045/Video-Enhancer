# Server
PORT=5000
NODE_ENV=development

# MongoDB — leave empty to use embedded NeDB (zero setup)
# Set to use MongoDB instead:
# MONGODB_URI=mongodb://localhost:27017/cine-remaster

# Redis (for BullMQ queue) — leave empty to use in-memory queue
# Set to use Redis:
# REDIS_HOST=localhost
# REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Python AI Engine
PYTHON_ENGINE_PATH=../python-engine
PYTHON_PATH=python

# Storage
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

# Max file size (MB)
MAX_FILE_SIZE=2048

# GPU
CUDA_ENABLED=true
