# Server
PORT=5000
NODE_ENV=development

# MongoDB — leave empty to use embedded NeDB (zero setup)
# Set to use MongoDB instead:
# MONGODB_URI=mongodb://localhost:27017/cine-remaster

# Redis (for BullMQ queue) — leave empty to use in-memory queue
# Set to use Redis:
# REDIS_HOST=localhost
# REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Python AI Engine
PYTHON_ENGINE_PATH=../python-engine
PYTHON_PATH=python

# Storage
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

# Max file size (MB)
MAX_FILE_SIZE=2048

# GPU
CUDA_ENABLED=true

# ── Phase 2: AI enhancement tier (RunPod serverless GPU) ──
# When all three are set, enhance jobs with pipeline.engine === 'ai' are dispatched
# to the RunPod GPU endpoint (Real-ESRGAN + GFPGAN). If unset, the app falls back to
# the FFmpeg tier automatically. See runpod/README.md for setup.
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=
# PUBLIC_BASE_URL=https://your-app.onrender.com   # so the GPU worker can fetch /uploads

# Subtitle generation (faster-whisper) model: tiny | base | small
# WHISPER_MODEL=tiny
